---
---
<form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="nl" class="newsletter">
  <input type="hidden" name="form-name" value="newsletter" />
  <p style="display:none"><label>Do not fill: <input name="bot-field" /></label></p>
  <input type="email" name="email" placeholder="Ton email" required />
  <label class="consent">
    <input type="checkbox" name="consent" required />
    J'accepte de recevoir la newsletter d'À CONTRE-PIED. Désinscription sur simple demande.
  </label>
  <button type="submit">S'abonner</button>
  <p id="nl-msg" aria-live="polite"></p>
</form>

<script>
  const f = document.getElementById('nl') as HTMLFormElement;
  const msg = document.getElementById('nl-msg')!;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = 'Envoi…';
    const body = new URLSearchParams(new FormData(f) as unknown as Record<string, string>).toString();
    const r = await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    });
    msg.textContent = r.ok ? 'Merci, tu es inscrit·e !' : 'Erreur, réessaie plus tard.';
    if (r.ok) f.reset();
  });
</script>

<style>
  .newsletter { display: flex; flex-direction: column; gap: 0.75rem; max-width: 28rem; }
  .newsletter input[type="email"] {
    padding: 0.75rem; border: 2px solid #111111; background: #F4F0E8; border-radius: 0;
  }
  .newsletter button {
    padding: 0.75rem; border: 2px solid #111111; background: #E43D30; color: #F4F0E8;
    font-weight: 700; cursor: pointer; border-radius: 0;
  }
  .consent { font-size: 0.85rem; }
</style>
