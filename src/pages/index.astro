---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { SECTIONS, slugOf, fmt } from '../lib';
const all = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [lead, ...rest] = all;
const side = rest.slice(0, 3);
---
<Base>
  <main class="wrap">
    {lead ? (
      <section class="hero">
        <div class="main">
          {lead.data.image ? <img class="cover" src={lead.data.image} alt="" /> : <div class="ph red">À la une</div>}
          <span class="tag">{lead.data.section}</span>
          <h1><a href={`/articles/${lead.id}/`} style="text-decoration:none">{lead.data.title}</a></h1>
          {lead.data.chapo && <p>{lead.data.chapo}</p>}
          <p class="meta" style="margin-top:12px">Par {lead.data.author} · {fmt(lead.data.date)}</p>
        </div>
        <div class="side">{side.map((a) => <Card a={a} />)}</div>
      </section>
    ) : <p class="empty">Aucun article pour l’instant. Rendez-vous sur /admin pour publier le premier.</p>}
    {SECTIONS.map((s) => {
      const items = all.filter((a) => slugOf(a.data.section) === s.slug).slice(0, 3);
      return items.length > 0 && (
        <>
          <div class="sectionhead"><h2>{s.name}</h2><a href={`/${s.slug}/`}>Tout voir →</a></div>
          <section class="grid">{items.map((a) => <Card a={a} />)}</section>
        </>
      );
    })}
  </main>
</Base>
